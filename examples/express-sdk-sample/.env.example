# API token with the "sdk" scope, bound to a project or workspace.
MOCKSHIFT_API_KEY=tkh_replace_me
MOCKSHIFT_BASE_URL=https://mockshift.example.com

# Project and collection the SDK syncs into (created on first sync when the
# token is workspace-bound).
MOCKSHIFT_PROJECT=SDK E2E Sample
MOCKSHIFT_COLLECTION=SDK E2E Collection

# Public URL of this sample app, stored as the base URL of synced requests so
# they can be run from Mockshift.
SAMPLE_BASE_URL=http://127.0.0.1:4100
PORT=4100

# Milliseconds to wait for a sync reply (remote instances need more than the
# SDK's 5s local-development default).
MOCKSHIFT_TIMEOUT_MS=30000
