// API Hub — Prisma ORM schema.
//
// NOTE: This schema is the application-facing ORM model. The authoritative
// DDL (constraints, CHECK rules, pgcrypto encryption, Row-Level Security)
// lives in db/migrations/001_init.sql and MUST be applied first. Field types
// here mirror the raw migration 1:1 (uuid columns via @db.Uuid).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

enum Role {
  ADMIN
  MANAGER
  EDITOR
  VIEWER
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum BodyType {
  NONE
  JSON
  FORM_URLENCODED
  MULTIPART
  RAW_TEXT
  GRAPHQL
}

enum VariableScope {
  GLOBAL
  WORKSPACE
  ENVIRONMENT
  REQUEST
}

enum RunTrigger {
  MANUAL
  CRON
  WEBHOOK
  WORKFLOW
  REGRESSION
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

// ------------------------------------------------------------- Auth/RBAC

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teams                     TeamMember[]
  orgMemberships            OrganizationMember[]
  workspaceMembers          WorkspaceMember[]
  ownedOrganizations        Organization[]       @relation("OrganizationOwner")
  variablesCreated          Variable[]           @relation("VariableCreator")
  runs                      RunHistory[]
  managedProjects           ProjectManager[]
  grantedProjectMemberships ProjectMember[]      @relation("ProjectMemberGranter")
  projectMemberships        ProjectMember[]
  accessRequests            AccessRequest[]
  accessRequestsReviewed    AccessRequest[]      @relation("AccessRequestReviewer")
  auditLogs                 AuditLog[]
  automations               Automation[]
  notifications             Notification[]
}

model Team {
  id      String       @id @default(uuid()) @db.Uuid
  name    String
  members TeamMember[]
}

model TeamMember {
  id     String @id @default(uuid()) @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  role   Role

  @@unique([teamId, userId])
}

model Organization {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id])
  ownerId String @db.Uuid

  members    OrganizationMember[]
  workspaces Workspace[]
}

model OrganizationMember {
  id     String       @id @default(uuid()) @db.Uuid
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String       @db.Uuid
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String       @db.Uuid
  role   Role

  @@unique([orgId, userId])
}

// ------------------------------------------------------- Workspace layer

model Workspace {
  id             String       @id @default(uuid()) @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  name           String
  visibility     Visibility   @default(PRIVATE)

  members      WorkspaceMember[]
  projects     Project[]
  environments Environment[]
  variables    Variable[]
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  role        Role

  @@unique([workspaceId, userId])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  name        String

  collections    Collection[]
  workflows      WorkflowChain[]
  managers       ProjectManager[]
  members        ProjectMember[]
  accessRequests AccessRequest[]
  automations    Automation[]
}

// Project managers: users empowered to govern an assigned project.
model ProjectManager {
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  @@id([projectId, userId])
}

// Users granted explicit project-level access.
model ProjectMember {
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  role      Role     @default(VIEWER)
  granter   User?    @relation("ProjectMemberGranter", fields: [grantedBy], references: [id], onDelete: SetNull)
  grantedBy String?  @db.Uuid
  createdAt DateTime @default(now())

  @@id([projectId, userId])
}

// Pending requests to join a project.
model AccessRequest {
  id          String    @id @default(uuid()) @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  role        Role      @default(VIEWER)
  reason      String?
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  reviewer    User?     @relation("AccessRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedBy  String?   @db.Uuid
  reviewedAt  DateTime?

  @@unique([projectId, userId])
  @@index([status])
}

// Governance/audit trail.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?  @db.Uuid
  entityType String
  entityId   String?  @db.Uuid
  action     String
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Scheduled / webhook-triggered workflow runs.
model Automation {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String        @db.Uuid
  workflow        WorkflowChain @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId      String        @db.Uuid
  triggerType     String
  scheduleCron    String?
  webhookToken    String?       @unique
  inputVars       Json          @default("{}")
  notifyOnFailure Boolean       @default(true)
  enabled         Boolean       @default(true)
  creator         User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy       String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastRunAt       DateTime?
  lastStatus      RunStatus?

  @@index([projectId])
}

// In-app notifications.
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  title     String
  body      String?
  kind      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// -------------------------------------------------------------- Content

model Collection {
  id        String  @id @default(uuid()) @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @db.Uuid
  name      String

  requests ApiRequest[]
}

model ApiRequest {
  id           String     @id @default(uuid()) @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String     @db.Uuid
  name         String
  method       HttpMethod @default(GET)
  url          String
  headers      Json?      @default("[]")
  queryParams  Json?      @default("[]")
  bodyType     BodyType   @default(NONE)
  bodyJson     Json?
  bodyText     String?

  variables  Variable[]
  runHistory RunHistory[]
}

model Environment {
  id          String    @id @default(uuid()) @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  name        String
  isActive    Boolean   @default(false)

  variables Variable[]
}

// Encrypted variables. Secrets are AES-encrypted at the application layer
// (valueEncrypted = hex iv+ciphertext+tag, master key from KMS/ENV, never in
// DB). Non-secrets use valuePlain for queryability. Raw SQL CHECK guarantees
// exactly one representation, and one FK per scope is set.
model Variable {
  id             String        @id @default(uuid()) @db.Uuid
  key            String
  scope          VariableScope
  isSecret       Boolean       @default(true)
  valueEncrypted String?       @db.Text
  valuePlain     String?
  createdBy      String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace     Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String?      @db.Uuid
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId String?      @db.Uuid
  request       ApiRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId     String?      @db.Uuid
  creator       User?        @relation("VariableCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([environmentId])
  @@index([requestId])
}

// ----------------------------------------------------------- Automation

model WorkflowChain {
  id         String  @id @default(uuid()) @db.Uuid
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String  @db.Uuid
  name       String
  // Orchestration graph: steps, loops, conditional skips, delays, webhooks.
  definition Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runs      RunHistory[]
  automations Automation[]
}

// ---------------------------------------------------------------- Logs

model RunHistory {
  id               String         @id @default(uuid()) @db.Uuid
  request          ApiRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId        String?        @db.Uuid
  workflow         WorkflowChain? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  workflowId       String?        @db.Uuid
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId           String?        @db.Uuid
  trigger          RunTrigger
  status           RunStatus
  requestSnapshot  Json?
  responseSnapshot Json?
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?

  testResults TestResult[]

  @@index([requestId, startedAt])
  @@index([workflowId, startedAt])
  @@index([userId, startedAt])
}

model TestResult {
  id         String     @id @default(uuid()) @db.Uuid
  run        RunHistory @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId      String     @db.Uuid
  testName   String
  passed     Boolean
  assertions Json?
  error      String?

  @@index([runId])
}
