# Copy to .env (or export) and fill in. Never commit real credentials.
#
# Transactional email (signup verification, password reset) is used when
# SMTP_URL or SMTP_HOST is set. When neither is set the mailer logs
# "SMTP not configured; skipped" and callers that report an outcome to the user
# (resend verification) fail with 503 instead of pretending the mail was sent.
# Verify a config without starting the app:
#   node scripts/send-test-email.js you@example.com
#
APP_URL=https://mockshift.keerainnovations.com

# The main app and the subscription portal are separate origins that share the
# same users table and session signature. Set COOKIE_DOMAIN to their common
# parent so one login works on both (e.g. `.example.com` for
# app.example.com + portal.example.com). Leave unset for host-only cookies;
# the online preview derives it automatically for `<port>-<id>.monkeycode-ai.live`.
# COOKIE_DOMAIN=.example.com

# --- Self-hosted mailcow -----------------------------------------------------
# SMTP_HOST is the mailcow hostname (the server's FQDN, e.g. mail.example.com —
# it must match the certificate). SMTP_USER is the *full mailbox address* (not a
# bare username) and SMTP_FROM must be that same mailbox or a sender alias you
# created in mailcow, otherwise mailcow rejects the sender.
#
#   STARTTLS (recommended)      implicit TLS (SMTPS)
#     SMTP_PORT=587               SMTP_PORT=465
#     SMTP_SECURE=0               SMTP_SECURE=1
#
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-your-mailbox-password
SMTP_FROM=Mockshift <noreply@example.com>
# Set to 0 only when the mailcow cert is self-signed (the default mailcow
# image ships one). Leave unset so a public CA is still verified.
# SMTP_TLS_REJECT_UNAUTHORIZED=0

# Alternative: one URL instead of SMTP_HOST/PORT/SECURE/USER/PASS.
# Note the scheme decides the port/TLS: smtp:// = STARTTLS, smtps:// = implicit TLS.
# SMTP_URL=smtp://noreply@example.com:password@mail.example.com:587

# --- Cashfree payment gateway ------------------------------------------------
# Leave CASHFREE_APP_ID / CASHFREE_SECRET_KEY unset to keep the simulated
# gateway; the Cashfree checkout routes then answer 503. CASHFREE_SECRET_KEY is
# also the HMAC key used to verify incoming webhook signatures.
CASHFREE_APP_ID=replace-with-your-cashfree-app-id
CASHFREE_SECRET_KEY=replace-with-your-cashfree-secret-key
# sandbox (default) | production
CASHFREE_ENV=sandbox
# Cashfree PG API version header (x-api-version).
CASHFREE_API_VERSION=2023-08-01
# Public base URL of the subscription portal. Used to build the checkout
# return_url and the default webhook notify_url.
PORTAL_APP_URL=https://portal.example.com
# Optional: override the webhook notify_url Cashfree calls. When unset it
# defaults to ${PORTAL_APP_URL}/api/public/webhooks/cashfree.
# CASHFREE_WEBHOOK_URL=https://portal.example.com/api/public/webhooks/cashfree
