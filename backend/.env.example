# Copy to .env (or export) and fill in. Never commit real credentials.
# SMTP is optional: when neither SMTP_URL nor SMTP_HOST is set the mailer logs
# the message and skips sending (best-effort; no request fails because of it).
APP_URL=http://localhost:3000
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM=API Hub <noreply@example.com>
# Alternative: set SMTP_URL instead of SMTP_HOST/SMTP_PORT/SMTP_SECURE.
# SMTP_URL=smtp://user:password@mail.example.com:587
